generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Residency {
  NRI
  RESIDENT_INDIAN
  OTHER
}

// The tenant. Everything in the platform is scoped to a Household.
// Each self-signup customer gets exactly one Household of their own.
model Household {
  id                   String        @id @default(cuid())
  name                 String
  // Required at signup (not silently defaulted there — the signup form
  // blocks submission without an explicit choice); defaults here exist only
  // so this migration doesn't fail against already-existing households,
  // which get backfilled to these placeholders and should update them from
  // Settings.
  country              String        @default("")
  timeZone             String        @default("UTC") // IANA zone, e.g. "Asia/Dubai" — drives all Monthly Tracking period math
  baseCurrency         String        @default("USD")
  operationalCurrency  String        @default("USD")
  isSuspended          Boolean       @default(false) // platform admin can suspend a client's access
  subscriptionStatus   String        @default("FREE") // FREE | TRIAL | PAID — plain data, no billing logic yet
  subscriptionExpiresAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  users         User[]
  familyMembers FamilyMember[]
  accounts          Account[]
  liabilities       Liability[]
  allocationTargets AllocationTarget[]
  goals             Goal[]
  monthlyCategories MonthlyCategory[]
  monthlyLineItems  MonthlyLineItem[]
  monthlyEntries    MonthlyEntry[]

  @@map("households")
}

// An authenticated login. Regular clients belong to exactly one Household.
// The platform Super Admin (isPlatformOwner = true) has no household at all —
// it's purely an administrative account.
model User {
  id             String    @id @default(cuid())
  householdId    String?
  household      Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  isPlatformOwner Boolean  @default(false)
  status         String    @default("active") // active | disabled
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  familyMember   FamilyMember? // optional link — the "Self" member for this login, if any

  @@index([householdId])
  @@map("users")
}

// A financial entity within a Household. May or may not have a login.
// Minors and most family members will never have a linkedUser.
model FamilyMember {
  id                  String     @id @default(cuid())
  householdId         String
  household           Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  linkedUserId        String?    @unique
  linkedUser          User?      @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  name                String
  relationship        String     // e.g. Self, Spouse, Son, Daughter, Other
  operationalCurrency String     @default("USD")
  residencyStatus     Residency  @default(NRI)
  dateOfBirth         DateTime?
  city                String?    // required for the "Self" member (the subscriber), optional for others
  address             String?    // required for the "Self" member (the subscriber), optional for others
  isMinor             Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  accounts    Account[]
  liabilities Liability[]

  @@index([householdId])
  @@map("family_members")
}

enum AssetClass {
  CASH
  FIXED_DEPOSIT
  STOCKS
  MUTUAL_FUNDS
  BONDS
  GOLD              // physical gold — unchanged
  SGB               // Sovereign Gold Bonds, distinct from physical GOLD
  RETIREMENT_SAVINGS
  INSURANCE_LINKED
  GOVERNMENT_SCHEME // PPF, SSA, NPS: simple value-only for now
  REAL_ESTATE
  CRYPTOCURRENCY
  OTHER
}

enum CompoundingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  AT_MATURITY
}

enum AutoRenewalType {
  NONE
  PAYOUT_TO_ACCOUNT
  RENEW_PRINCIPAL_ONLY
  RENEW_PRINCIPAL_AND_INTEREST
}

// A single holding — a specific FD, mutual fund, bank account, PPF, SGB, etc.
// The asset class powers allocation charts; holdingName is free text so it
// works for any country's specific product names. Category-specific fields
// below are all nullable — a given row only populates the ones relevant to
// its assetClass (same one-table-with-optional-columns pattern as Liability).
model Account {
  id             String       @id @default(cuid())
  householdId    String
  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  assetClass     AssetClass
  holdingName    String       // e.g. "PFC FD", "PPF", "Nippon Small Cap Fund", "401(k)"
  currency       String
  currentValue   Decimal
  purchaseValue  Decimal?     // optional cost basis — mainly used for Real Estate

  // Identifier — bank A/C number, MF folio, stock ticker, SGB tranche name, policy number
  accountOrFolioNo String?

  // Link to live-priced securities (Mutual Funds & Stocks only)
  securityId     String?
  security       SecuritiesMaster? @relation(fields: [securityId], references: [id])

  // Units / quantity — MF units, stock shares, SGB grams
  unitsHeld      Decimal?
  avgBuyPrice    Decimal?     // weighted average NAV / price / issue price per unit

  // Fixed Deposit specific
  interestRatePct      Decimal?
  startDate            DateTime?
  maturityDate         DateTime?
  compoundingFrequency CompoundingFrequency?
  autoRenewalType      AutoRenewalType?
  isTaxExempt          Boolean?  // NRE FDs, PPF interest

  // Mutual Fund specific
  sipMonthlyAmount Decimal?

  lastUpdated    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([householdId])
  @@index([familyMemberId])
  @@index([securityId])
  @@map("accounts")
}

enum SecurityType {
  MUTUAL_FUND
  STOCK
  ETF
}

// Global, household-independent directory of tradeable securities, seeded
// and refreshed by scripts/seed-securities.ts and the price-sync route —
// never by the app's own migrate/seed step. Powers the autocomplete search
// when adding a Mutual Fund or Stock, and holds the last synced price.
model SecuritiesMaster {
  id             String       @id @default(cuid())
  securityType   SecurityType
  country        String       @default("IN") // "IN", "US"
  tickerOrCode   String       // scheme code ("122639") or ticker ("TCS.NS", "AAPL")
  name           String       // full scheme/company name, incl. Direct/Regular, Growth/IDCW
  isin           String?
  exchange       String?      // "AMFI", "NSE", "BSE", "NASDAQ", "NYSE"
  lastPrice      Decimal?
  priceUpdatedAt DateTime?
  createdAt      DateTime     @default(now())

  accounts       Account[]

  @@unique([tickerOrCode, securityType])
  @@index([name])
  @@map("securities_master")
}

enum LiabilityType {
  HOME_LOAN
  CAR_LOAN
  PERSONAL_LOAN
  CREDIT_CARD
  DEVICE_EMI
  OTHER
}

// A loan, mortgage, or running balance owed. Outstanding balance nets
// against Account.currentValue to produce Net Worth. Amortization
// (principal/interest split, payoff timeline) is computed live from
// outstandingBalance + interestRate + emiAmount — nothing here is a
// stored schedule. Loans with interestRate null/0 (credit cards, 0%
// device EMIs) are simple running balances with no amortization math.
model Liability {
  id                 String        @id @default(cuid())
  householdId        String
  household          Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  familyMemberId     String
  familyMember       FamilyMember  @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  liabilityType      LiabilityType
  name               String        // "ICICI Home Loan", "Credit Card Running Balance"
  currency           String
  outstandingBalance Decimal
  originalAmount     Decimal?      // original principal, if known — needed for amortization progress %
  interestRate       Decimal?      // annual %, e.g. 8.65 — null/0 means non-amortizing (credit card, 0% EMI)
  emiAmount          Decimal?      // monthly payment, reference only, not wired to Monthly Tracking in this phase
  targetPayoffDate   DateTime?
  lastUpdated        DateTime      @default(now())
  accountReference   String?       // loan A/C # or card last-4 digits — "Loan A/C: 0048-HL-91024"
  isRevolving        Boolean       @default(false) // true for credit cards / lines of credit
  statementDueDay    Int?          // day-of-month billing cycle closes, revolving lines only
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lineItems MonthlyLineItem[]

  @@index([householdId])
  @@index([familyMemberId])
  @@map("liabilities")
}

// Household-level target allocation % per asset class, compared against
// actual % computed live from Accounts.
model AllocationTarget {
  id            String     @id @default(cuid())
  householdId   String
  household     Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assetClass    AssetClass
  targetPercent Decimal    // stored as a fraction, e.g. 0.30 = 30%
  updatedAt     DateTime   @updatedAt

  @@unique([householdId, assetClass])
  @@map("allocation_targets")
}

// A named milestone — e.g. "Retirement Corpus", "Daughter's Education".
model Goal {
  id            String    @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal
  currency      String
  currentAmount Decimal   @default(0)
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([householdId])
  @@map("goals")
}

enum MonthlyCategoryType {
  INCOME
  OUTFLOW
}

enum MonthlyCategorySpendKind {
  FIXED
  VARIABLE
}

// A household-defined bucket (Income, EMI/Debt, Expenses, Subscriptions, Savings, ...).
// type determines whether it adds to or subtracts from Net Surplus.
model MonthlyCategory {
  id             String                    @id @default(cuid())
  householdId    String
  household      Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name           String
  type           MonthlyCategoryType
  sortOrder      Int                       @default(0)
  spendKind      MonthlyCategorySpendKind? // null allowed for INCOME categories, which don't need one
  isSubscription Boolean                   @default(false)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  lineItems MonthlyLineItem[]
  entries   MonthlyEntry[]

  @@index([householdId])
  @@map("monthly_categories")
}

// The recurring "plan" — e.g. "Home Loan EMI", "Netflix", "Daughter's SIP".
// baseAmount is the steady reference figure, set once on the Monthly Base
// page; it's snapshotted onto each MonthlyEntry's own baseAmount when that
// month is generated, so edits here never rewrite history — they only
// change what future months pick up.
model MonthlyLineItem {
  id             String          @id @default(cuid())
  householdId    String
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoryId     String
  category       MonthlyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  baseAmount     Decimal
  // Which calendar months (1-12) this line applies to. Empty array = every month.
  // e.g. quarterly rent = [1,4,7,10]; annual insurance = [7].
  repeatMonths   Int[]           @default([])
  startYear      Int             // don't generate entries before this year/month —
  startMonth     Int             // i.e. whenever the line item was created.
  isActive       Boolean         @default(true) // "stopped" lines don't generate new entries but keep history
  notes          String?         // the "Remark" column on Monthly Base — not copied onto generated entries
  liabilityId    String?         // opt-in: "this recurring expense is the EMI for that loan"
  liability      Liability?      @relation(fields: [liabilityId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  entries MonthlyEntry[]

  @@index([householdId])
  @@index([categoryId])
  @@index([liabilityId])
  @@map("monthly_line_items")
}

// One row in one month's sheet. Either generated from a MonthlyLineItem
// (lineItemId set, name/baseAmount snapshotted at generation time) or a
// standalone one-off entry added directly into a specific month (lineItemId
// null, baseAmount == plannedAmount at creation since there's no separate
// "base" for something one-time).
model MonthlyEntry {
  id             String           @id @default(cuid())
  householdId    String
  household      Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoryId     String
  category       MonthlyCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lineItemId     String?
  lineItem       MonthlyLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  year           Int
  month          Int              // 1-12
  name           String           // copied from line item at generation, or set directly for one-offs
  baseAmount     Decimal          // reference snapshot from the line item — shown, not directly editable
  plannedAmount  Decimal          // this month's actual plan — defaults to baseAmount, freely editable
  actualAmount   Decimal?         // null until the user fills it in
  isSkipped      Boolean          @default(false) // skips this one occurrence without touching the line item
  notes          String?
  // Idempotency guard for the EMI->principal auto-sync: set once, when this
  // entry's EMI was applied to the linked liability's outstandingBalance, so
  // re-editing or un-marking the entry later can't double-count or lose
  // track of what already happened to the loan balance.
  principalAppliedAmount Decimal?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([lineItemId, year, month])
  @@index([householdId, year, month])
  @@map("monthly_entries")
}
