# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Connection string from your Neon project (Dashboard > Connection Details).
# Use the "pooled" connection string for the app.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random string, 32+ characters, used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used only by `npm run seed` to create your private household + admin login.
# This account is NOT created through the public /signup page.
ADMIN_EMAIL="admin@wealthbridge.local"
ADMIN_INITIAL_PASSWORD="ChangeMeInEnv123!"
